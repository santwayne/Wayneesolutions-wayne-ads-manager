# ---- Core ----
NODE_ENV=production
PORT=4100
PUBLIC_BASE_URL=https://ads-api.wayneesolutions.com
APP_URL=https://ads.wayneesolutions.com
DATABASE_URL=postgres://USER:PASS@HOST:5432/wayne_ads
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=

# ---- Token encryption ----
# Prod: AWS KMS key (EC2 role needs kms:Encrypt/Decrypt). Dev: TOKEN_ENC_KEY = `openssl rand -base64 32`
KMS_KEY_ID=
AWS_REGION=ap-south-1
TOKEN_ENC_KEY=

# ---- Meta (Marketing API) ----
META_API_VERSION=v25.0            # always latest stable — change here, never in code
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=                 # Wayne Business Manager id
META_SYSTEM_USER_TOKEN=           # Phase 1 agency mode
META_WEBHOOK_VERIFY_TOKEN=
META_LOGIN_CONFIG_ID=             # Phase 2 Facebook Login for Business
META_WRITES_DISABLED=0            # 1 = block every write call (sandbox/dry deployments)
# Location expansion OFF patch merged into every ad set targeting. Verify with `npm run verify:meta`.
# META_GEO_EXPANSION_OFF_PATCH={"targeting_automation":{"individual_setting":{"geo":0}}}

# ---- WhatsApp (Loopdesk number) ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_PREFIX=loopdesk
WA_MODE=live                      # log = print instead of send

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- Loopdesk AI Jobs (CRM) + WayneRing ----
JOBS_CRM_API_URL=https://crm-hcm.wayneesolutions.com/api/v1
JOBS_CRM_API_KEY=
JOBS_CRM_WEBHOOK_SECRET=
WAYNERING_API_URL=
WAYNERING_API_KEY=

# ---- Optional ----
GOOGLE_MAPS_API_KEY=              # WhatsApp mode: area text -> lat/lng (else asks for location pin)
RULES_DRY_RUN=1                   # spec: first 2 weeks suggestions only. Set 0 after accuracy review.
GST_RATE=0.18
GST_ON_AD_SPEND=1                 # confirm with CA

# ======== Phase 2 ========
# Loopdesk hub (regularsplatform) — same HUB_SECRET as HUB_SECRET_WAYNE_ADS in the hub .env
HUB_SECRET=
HUB_AUDIENCE=wayne-ads
HUB_EVENTS_URL=https://app.loopdeskai.wayneesolutions.com/api/v1/events
HUB_EVENTS_KEY=                   # rk_live_... from the hub
WAYNE_AGENCY_ORG_ID=1             # hub clients appear in Wayne's agency dashboard

# Razorpay (wallet top-ups, invoices, self-serve subscription)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Ads API
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26
