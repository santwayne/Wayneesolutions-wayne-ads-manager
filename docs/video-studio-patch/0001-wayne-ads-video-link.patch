diff --git a/tests/test_ads_link.py b/tests/test_ads_link.py
new file mode 100644
index 0000000..ac39ec2
--- /dev/null
+++ b/tests/test_ads_link.py
@@ -0,0 +1,61 @@
+import time
+import uuid
+
+from jose import jwt
+
+from app.core.config import settings
+from app.database.session import SessionLocal
+from app.models.ad_project import AdProject, AdState
+from app.models.client import Client
+
+SECRET = "a" * 40
+
+
+def token(sub, **kw):
+    now = int(time.time())
+    claims = {"iss": "wayne-ads", "aud": "videoStudio", "sub": sub, "purpose": "list_videos", "jti": str(uuid.uuid4()), "iat": now, "exp": now + 120}
+    claims.update(kw)
+    return jwt.encode(claims, SECRET, algorithm="HS256")
+
+
+def seed():
+    db = SessionLocal()
+    mine = Client(company_name="UJOY", email="u@x.in", hub_business_id="hub-1")
+    other = Client(company_name="Other", email="o@x.in", hub_business_id="hub-2")
+    db.add_all([mine, other]); db.flush()
+    db.add_all([
+        AdProject(client_id=mine.id, kind="video", brief="Brown sugar boba reel", state=AdState.DONE, seconds=15,
+                  outputs={"9:16": "/static/ads/a1/v916.mp4", "1:1": "/static/ads/a1/v11.mp4"}, script={"scenes": [{"image": "/static/ads/a1/s0.jpg"}]}),
+        AdProject(client_id=mine.id, kind="video", brief="Still rendering", state=AdState.RENDERING, outputs={}, script={}),
+        AdProject(client_id=other.id, kind="video", brief="Not yours", state=AdState.DONE, outputs={"9:16": "/static/ads/b/v.mp4"}, script={}),
+    ])
+    db.commit(); db.close()
+
+
+def test_lists_only_this_business_done_videos(http, monkeypatch):
+    monkeypatch.setattr(settings, "ADS_LINK_SECRET", SECRET)
+    monkeypatch.setattr(settings, "PUBLIC_BASE_URL", "https://aivideo.example.com")
+    seed()
+    r = http.get("/api/v1/hub/videos", headers={"authorization": f"Bearer {token('hub-1')}"})
+    assert r.status_code == 200, r.text
+    items = r.json()["items"]
+    assert {i["aspect"] for i in items} == {"9:16", "1:1"}
+    assert all(i["url"].startswith("https://aivideo.example.com/static/ads/a1/") for i in items)
+    assert items[0]["thumbnail_url"] == "https://aivideo.example.com/static/ads/a1/s0.jpg"
+    assert all("Not yours" not in i["title"] for i in items)
+
+
+def test_rejects_bad_tokens(http, monkeypatch):
+    monkeypatch.setattr(settings, "ADS_LINK_SECRET", SECRET)
+    assert http.get("/api/v1/hub/videos").status_code == 401
+    assert http.get("/api/v1/hub/videos", headers={"authorization": f"Bearer {token('hub-1', purpose='sso')}"}).status_code == 401
+    bad = jwt.encode({"iss": "wayne-ads", "aud": "videoStudio", "sub": "hub-1", "purpose": "list_videos", "jti": "x", "iat": int(time.time()), "exp": int(time.time()) + 60}, "b" * 40, algorithm="HS256")
