@@ -0,0 +1,79 @@
+"""
+Wayne Ads Manager -> Video Studio: list a business's finished videos so the ads wizard
+can import them (one platform, Bundle A).
+
+  GET /api/v1/hub/videos      Authorization: Bearer <JWT>
+
+The JWT is signed by Wayne Ads Manager with ADS_LINK_SECRET (same value as
+VIDEO_STUDIO_LINK_SECRET there): HS256, iss "wayne-ads", aud "videoStudio",
+purpose "list_videos", sub <Loopdesk business id>, jti, <= 2 minutes.
+Only that business's DONE videos come back; nothing can be changed through it.
+"""
+import time
+
+from fastapi import APIRouter, Depends, Header, HTTPException
+from jose import JWTError, jwt
+from sqlalchemy.orm import Session
+
+from app.core.config import settings
+from app.database.session import get_db
+from app.models.ad_project import AdProject, AdState
+from app.models.client import Client
+
+router = APIRouter(prefix="/api/v1/hub", tags=["Hub (Wayne Ads link)"])
+
+_seen: dict[str, float] = {}
+ASPECTS = {"9:16": (1080, 1920), "4:5": (1080, 1350), "1:1": (1080, 1080), "16:9": (1920, 1080)}
+
+
+def _verify(authorization: str | None) -> dict:
+    secret = settings.ADS_LINK_SECRET or ""
+    if len(secret) < 32:
+        raise HTTPException(status_code=503, detail="ADS_LINK_SECRET is not set on Video Studio")
+    if not authorization or not authorization.lower().startswith("bearer "):
+        raise HTTPException(status_code=401, detail="Missing token")
+    try:
+        claims = jwt.decode(authorization[7:].strip(), secret, algorithms=["HS256"], audience="videoStudio", issuer="wayne-ads")
+    except JWTError as e:
+        raise HTTPException(status_code=401, detail=f"Token rejected: {e}")
+    if claims.get("purpose") != "list_videos" or not claims.get("sub") or not claims.get("jti"):
+        raise HTTPException(status_code=401, detail="Token is for something else")
+    if time.time() - float(claims.get("iat", 0)) > 180:
+        raise HTTPException(status_code=401, detail="Token is too old")
+    now = time.time()
+    for k in [k for k, until in _seen.items() if until < now]:
+        _seen.pop(k, None)
+    if claims["jti"] in _seen:
+        raise HTTPException(status_code=401, detail="Token was already used")
+    _seen[claims["jti"]] = float(claims["exp"])
+    return claims
+
+
+def _abs(path: str) -> str:
+    base = (settings.PUBLIC_BASE_URL or "").rstrip("/")
+    return path if path.startswith("http") else f"{base}{path}"
+
+
+@router.get("/videos")
+def list_videos(authorization: str | None = Header(None), db: Session = Depends(get_db)):
+    claims = _verify(authorization)
+    client = db.query(Client).filter(Client.hub_business_id == claims["sub"]).first()
+    if not client:
+        return {"items": []}
+    ads = (db.query(AdProject)
+           .filter(AdProject.client_id == client.id, AdProject.kind == "video", AdProject.state == AdState.DONE)
+           .order_by(AdProject.created_at.desc()).limit(50).all())
+    items = []
+    for ad in ads:
+        scenes = (ad.script or {}).get("scenes") or []
+        thumb = next((s.get("image") for s in scenes if s.get("image")), None)
+        for aspect, path in (ad.outputs or {}).items():
+            if not str(path).endswith((".mp4", ".mov")):
+                continue
+            w, h = ASPECTS.get(aspect, (None, None))
+            items.append({
+                "id": f"{ad.id}:{aspect}", "title": (ad.brief or "Video")[:80], "url": _abs(path),
+                "thumbnail_url": _abs(thumb) if thumb else None, "seconds": ad.seconds, "aspect": aspect,
+                "width": w, "height": h, "created_at": ad.created_at.isoformat() if ad.created_at else None,
+            })
+    return {"items": items}
